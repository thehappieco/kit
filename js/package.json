{
  "name": "@thehappieco/kit",
  "version": "0.7.0",
  "description": "The Happie Co's shared cryptographic kit: HPKE, sealed envelopes, the zero-knowledge account scheme, passkey PRF wraps, request signing, a product's platform wrap, the Wappie profile and Mailie's key scheme, the platform's account protocol with its key delivery and passkeys, and the relying party of its id.",
  "type": "module",
  "license": "Apache-2.0",
  "repository": "github:thehappieco/kit",
  "engines": {
    "node": ">=22"
  },
  "files": [
    "dist",
    "NOTICE"
  ],
  "sideEffects": [
    "./dist/kdf.worker.js"
  ],
  "exports": {
    "./bytes": { "types": "./dist/bytes.d.ts", "import": "./dist/bytes.js" },
    "./jcs": { "types": "./dist/jcs.d.ts", "import": "./dist/jcs.js" },
    "./errors": { "types": "./dist/errors.d.ts", "import": "./dist/errors.js" },
    "./hpke": { "types": "./dist/hpke.d.ts", "import": "./dist/hpke.js" },
    "./seal": { "types": "./dist/seal.d.ts", "import": "./dist/seal.js" },
    "./account": { "types": "./dist/account.d.ts", "import": "./dist/account.js" },
    "./kdf.worker": { "types": "./dist/kdf.worker.d.ts", "import": "./dist/kdf.worker.js" },
    "./passkey": { "types": "./dist/passkey.d.ts", "import": "./dist/passkey.js" },
    "./browserAccount": { "types": "./dist/browserAccount.d.ts", "import": "./dist/browserAccount.js" },
    "./reqhmac": { "types": "./dist/reqhmac.d.ts", "import": "./dist/reqhmac.js" },
    "./platformwrap": { "types": "./dist/platformwrap.d.ts", "import": "./dist/platformwrap.js" },
    "./profiles/wappie": { "types": "./dist/profiles/wappie.d.ts", "import": "./dist/profiles/wappie.js" },
    "./profiles/mailie": { "types": "./dist/profiles/mailie.d.ts", "import": "./dist/profiles/mailie.js" },
    "./profiles/platform": { "types": "./dist/profiles/platform.d.ts", "import": "./dist/profiles/platform.js" },
    "./profiles/platform/core": { "types": "./dist/profiles/platform/core.d.ts", "import": "./dist/profiles/platform/core.js" },
    "./oidc-rp": { "types": "./dist/oidc-rp.d.ts", "import": "./dist/oidc-rp.js" }
  },
  "dependencies": {
    "@noble/hashes": "2.4.0"
  },
  "devDependencies": {
    "@types/node": "26.6.0",
    "@vitest/browser": "3.2.7",
    "fake-indexeddb": "6.2.5",
    "playwright": "1.63.0",
    "typescript": "5.9.3",
    "vitest": "3.2.7"
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:browser": "vitest run --config vitest.browser.config.ts"
  }
}
